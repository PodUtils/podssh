{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash",
      "Bash(:*)",
      "Bash(*)",
      "Read",
      "Edit",
      "Write",
      "NotebookEdit",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",
      "Agent",
      "Skill",
      "Workflow",
      "Monitor",
      "ToolSearch",
      "mcp__github",
      "mcp__github__*",
      "mcp__claude-code-remote",
      "mcp__claude-code-remote__*",
      "mcp__Claude_Docs",
      "mcp__Claude_Docs__*",
      "TaskStop",
      "TaskCreate",
      "TaskUpdate",
      "TaskList",
      "TaskGet",
      "TaskOutput",
      "SendMessage",
      "ListAgents",
      "ReadNotifications",
      "ScheduleWakeup",
      "SendUserFile",
      "PushNotification",
      "Artifact",
      "ArtifactComments",
      "ArtifactData",
      "CronCreate",
      "CronList",
      "CronDelete",
      "EnterWorktree",
      "ExitWorktree",
      "ListMcpResourcesTool",
      "ReadMcpResourceTool",
      "mcp__ccd_session",
      "mcp__ccd_session__*",
      "mcp__Claude_Data",
      "mcp__Claude_Data__*"
    ],
    "additionalDirectories": [
      "/workspace/podutils",
      "/tmp",
      "/root/.cargo",
      "/root/.rustup"
    ],
    "defaultMode": "acceptEdits"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "env": {
    "CARGO_BUILD_JOBS": "4",
    "GIT_AUTHOR_NAME": "Azathothas",
    "GIT_AUTHOR_EMAIL": "ajamx101@gmail.com",
    "GIT_COMMITTER_NAME": "Azathothas",
    "GIT_COMMITTER_EMAIL": "ajamx101@gmail.com"
  },
  "includeCoAuthoredBy": false,
  "sessionUrl": false,
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/session-start.sh"
          }
        ]
      }
    ]
  }
}
