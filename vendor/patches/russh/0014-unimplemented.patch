+    USERAUTH_INFO_RESPONSE,
+    USERAUTH_GSSAPI_EXCHANGE_COMPLETE,
+    USERAUTH_GSSAPI_ERROR,
+    USERAUTH_GSSAPI_ERRTOK,
+    USERAUTH_GSSAPI_MIC,
+    GLOBAL_REQUEST,
+    REQUEST_SUCCESS,
+    REQUEST_FAILURE,
+    CHANNEL_OPEN,
+    CHANNEL_OPEN_CONFIRMATION,
+    CHANNEL_OPEN_FAILURE,
+    CHANNEL_WINDOW_ADJUST,
+    CHANNEL_DATA,
+    CHANNEL_EXTENDED_DATA,
+    CHANNEL_EOF,
