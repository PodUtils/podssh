+
+/// The step that the session's loop awaits in, and since when; none while it
+/// waits in its select (podssh's patch, T-780). A step that holds tells why
+/// the loop reads nothing of its stream.
+#[derive(Clone, Default, Debug)]
+pub struct Step(std::sync::Arc<std::sync::Mutex<Option<StepNow>>>);
+
+/// A step that awaits: since when, what, and the channel that it waits on.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub struct StepNow {
+    pub since: std::time::Instant,
+    pub what: &'static str,
+    pub channel: Option<ChannelId>,
+}
+
+impl Step {
+    pub(crate) fn at(&self, what: &'static str) {
+        self.set(what, None);
+    }
+
+    /// A step that waits on `channel` (its queue).
+    pub(crate) fn at_channel(&self, what: &'static str, channel: ChannelId) {
+        self.set(what, Some(channel));
+    }
+
+    fn set(&self, what: &'static str, channel: Option<ChannelId>) {
+        let now = StepNow { since: std::time::Instant::now(), what, channel };
+        *self.0.lock().unwrap_or_else(|e| e.into_inner()) = Some(now);
+    }
+
+    pub(crate) fn idle(&self) {
+        *self.0.lock().unwrap_or_else(|e| e.into_inner()) = None;
+    }
+
+    /// The step that awaits now; `None` in the select.
+    pub fn now(&self) -> Option<StepNow> {
+        *self.0.lock().unwrap_or_else(|e| e.into_inner())
+    }
+}
+
+/// The name of a message for [`Step`]: the messages whose reply can await.
+fn reply_step(kind: u8) -> &'static str {
+    match kind {
+        crate::msg::CHANNEL_DATA => "a reply to CHANNEL_DATA",
+        crate::msg::CHANNEL_EXTENDED_DATA => "a reply to CHANNEL_EXTENDED_DATA",
+        crate::msg::CHANNEL_WINDOW_ADJUST => "a reply to CHANNEL_WINDOW_ADJUST",
+        crate::msg::CHANNEL_REQUEST => "a reply to CHANNEL_REQUEST",
+        crate::msg::CHANNEL_EOF => "a reply to CHANNEL_EOF",
+        crate::msg::CHANNEL_CLOSE => "a reply to CHANNEL_CLOSE",
+        crate::msg::CHANNEL_OPEN => "a reply to CHANNEL_OPEN",
+        crate::msg::CHANNEL_OPEN_CONFIRMATION => "a reply to CHANNEL_OPEN_CONFIRMATION",
+        crate::msg::GLOBAL_REQUEST => "a reply to GLOBAL_REQUEST",
+        crate::msg::KEXINIT => "a reply to KEXINIT",
+        _ => "a reply to another message",
+    }
 }
 
