# T-560: podssh's settings of WARP's road drop the check of a tunnel that has
# just opened whatever PODSSH_WARP_PROBE says, so a front door that takes TLS
# and the CONNECT and then relays nothing gives a road that is open; the test
# of the settings of a run must fail. The check itself is pod-warp's (T-684,
# T-771).
ENTRY=T-560
GROUP=resume
EXPECT='test tests::the_settings_follow_the_run \.\.\. FAILED'
RUN='cargo test --locked -p podssh-warp --lib tests::the_settings_follow_the_run'
