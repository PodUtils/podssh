# T-611: the parser of a node's record of pkarr drops its OpenTunnel name, so
# a member with no --opentunnel-name and no name kept has no OpenTunnel road
# of the record; the test of the record against the stand-in OpenTunnel server
# and a server of pkarr on the loopback must fail.
ENTRY=T-611
GROUP=cli-tests
EXPECT='test opentunnel_record::a_member_with_no_name_given_or_kept_reaches_the_node_by_the_opentunnel_name_of_its_record \.\.\. FAILED'
RUN='cargo test --locked -p podssh-cli --features iroh-test --test opentunnel_road -- opentunnel_record::a_member_with_no_name_given_or_kept_reaches_the_node_by_the_opentunnel_name_of_its_record'
LIMIT=2400
