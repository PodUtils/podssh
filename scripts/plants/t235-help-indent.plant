# T-235: --help goes out of the block of the other options, first in the list
# in place of last (pod_model.rs builds the list that the help renders; the
# line of its own, `{:<12}`, went with the help's move to pod-manual); the
# test of the options in order, then --help, must fail.
ENTRY=T-235
GROUP=cli-tests
EXPECT='test the_options_are_the_rows_in_order_then_help \.\.\. FAILED'
RUN='cargo test --locked -p podssh-cli --test man_flag_parity -- the_options_are_the_rows_in_order_then_help'
LIMIT=2400
