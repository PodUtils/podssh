# T-736: the client of HyperDHT's road makes another pair's node key, so it
# looks up a topic that no node announces; the command line's test from end
# to end, through a private DHT of Node.js's hyperdht, must fail. On the
# runner, not in the build image: Node.js and its hyperdht package are there.
ENTRY=T-736
GROUP=host-hyperdht
EXPECT='test derp_hyperdht::a_derp_node_with_a_pair_serves_a_client_through_hyperdht_s_road \.\.\. FAILED'
SETUP='test -d .work/hdht/node_modules/hyperdht || { mkdir -p .work/hdht && cd .work/hdht && npm init -y >/dev/null && npm install --no-audit --no-fund hyperdht@6.36.0 >/dev/null; }'
RUN='PODSSH_HYPERDHT_TEST_NODE_PATH="$PWD/.work/hdht/node_modules" cargo test --locked --no-fail-fast -p podssh-cli --features hyperdht --test derp_road -- derp_hyperdht'
LIMIT=1800
