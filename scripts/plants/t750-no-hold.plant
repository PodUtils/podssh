# T-750: a member that no road reached is not held: it may come first again
# at once, and the test of the order in the hold must fail.
ENTRY=T-750
GROUP=cli-tests
EXPECT='test net::tag::tests::a_held_member_goes_last_and_the_others_are_shuffled \.\.\. FAILED'
RUN='cargo test --locked --no-fail-fast -p podssh-cli --lib -- net::tag::tests::a_held_member_goes_last_and_the_others_are_shuffled'
