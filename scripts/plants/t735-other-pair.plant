# T-735: the client of Yggdrasil's road makes another pair's node key, so it
# says hello to a node that is not there; the command line's test from end
# to end, through yggdrasil-go's own node, must fail. On the runner, not in
# the build image: yggdrasil-go is built there from its tag, with Go.
ENTRY=T-735
GROUP=host-ygg
EXPECT='test derp_ygg::a_derp_node_with_a_pair_serves_a_client_through_yggdrasil_s_road \.\.\. FAILED'
SETUP='test -x .work/yggdrasil || { git clone -q --depth 1 --branch v0.5.15 https://github.com/yggdrasil-network/yggdrasil-go .work/ygg-go && (cd .work/ygg-go && go build -o ../yggdrasil ./cmd/yggdrasil); }'
RUN='PODSSH_YGG_TEST_BIN="$PWD/.work/yggdrasil" cargo test --locked --no-fail-fast -p podssh-cli --features yggdrasil --test derp_road -- derp_ygg'
LIMIT=1800
