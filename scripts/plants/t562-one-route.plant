# T-562: podssh gives WARP's API its first route alone, as the registration
# dialled one name, so a first route that is not reached hands nothing to the
# second; the test of the bases of a run must fail. The routes in turn are
# pod-warp's (T-684, T-771).
ENTRY=T-562
GROUP=resume
EXPECT='test tests::the_bases_of_a_run_go_first \.\.\. FAILED'
RUN='cargo test --locked -p podssh-warp --lib tests::the_bases_of_a_run_go_first'
